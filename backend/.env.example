# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Gemini (Google AI Studio) - required for /api/ai/chat and /api/ai/voice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Bhashini (Indian language ASR/TTS/translation) - required for /api/ai/voice audio pipeline
# Without these, voice endpoints still work in "browser fallback" mode
# (browser Web Speech API for ASR/TTS) — see README for details.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=

# Phase 2 — Database + Auth
# Postgres connection string. For Supabase: Project Settings -> Database ->
# Connection string (URI), e.g.
# postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# Supabase/most managed Postgres require SSL. Set to "false" for local Postgres without SSL.
DATABASE_SSL=true

# Secret used to sign JWTs. Use a long random string in production
# (e.g. `openssl rand -hex 32`). Required for /api/auth/* and every
# authenticated route once DATABASE_URL is set.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Future phases
DATA_GOV_API_KEY=
MAPS_API_KEY=
